---
import BaseLayout from '@layouts/BaseLayout.astro';
import SiteBanner from '@components/SiteBanner.astro';
import SiteHeader from '@components/SiteHeader.astro';
import FeedHeader from '@components/FeedHeader.astro';
import EntryList from '@components/EntryList.astro';
import SiteSidebar from '@components/SiteSidebar.astro';
import { loadAllEntries } from '@utils/loadAllEntries';
import { formatMonthName, getYearMonth } from '@utils/date';
import { SITE_TITLE } from '@consts';

export async function getStaticPaths() {
	const allEntries = await loadAllEntries();
	const set = new Set<string>();

	for (const entry of allEntries) {
		const { year, month } = getYearMonth(entry.data.pubDate);
		set.add(`${year}-${month}`);
	}

	return Array.from(set).map((key) => {
		const [year, month] = key.split('-');
		return { params: { year, month } };
	});
}

const { year, month } = Astro.params;
const allEntries = await loadAllEntries();

const filtered = allEntries.filter((entry) => {
	const entryDate = getYearMonth(entry.data.pubDate);
	return entryDate.year === Number(year) && entryDate.month === month;
});

const monthName = formatMonthName(Number(year), Number(month));

const pageTitle = `Archive: ${monthName} ${year} | ${SITE_TITLE}`;
const pageDescription = `All notes, articles, and links published in ${monthName} ${year} by Arpit Agrawal.`;
---

<BaseLayout {pageTitle} pageDesc={pageDescription}>
	<SiteBanner />
	<div class="page">
		<div>
			<SiteHeader />
			<main id="main">
				<FeedHeader sectionTitle={`Archive: ${monthName} ${year}`} />
				<EntryList entries={filtered} />
			</main>
		</div>
		<SiteSidebar />
	</div>
</BaseLayout>
